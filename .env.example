# ==================== 本机 BetterGI 与玩家配置 ====================
# 请填写自己的 UID；不要将真实 .env 提交到 Git。
DEFAULT_UID=

# BetterGI 安装目录。留空时使用 Windows/WSL 的默认安装位置。
BGI_DIR=
BGI_EXE=BetterGI.exe

# 以下名称必须与本机 BetterGI 中实际创建的文件或脚本目录一致。
BGI_ONE_DRAGON_CONFIG_NAME=默认配置.json
BGI_MAP_CONFIG_NAME=地图素材.json
BGI_GLOBAL_CONFIG_RELATIVE_PATH=User/config.json
BGI_BOSS_CONFIG_RELATIVE_PATH=User/JsScript/批量讨伐角色养成材料BOSS/assets/config/config.json
# 留空时备份、Diff 和事务记录写入 BetterGI/User/GI_AgentBackups。
BGI_BACKUP_DIR=

# 对话历史保留条数，必须为正整数。
MAX_HISTORY_MESSAGES=20

# ==================== LLM 配置 ====================
LLM_PROVIDER=github
MODEL_NAME=gpt-4o-mini
GITHUB_TOKEN=

# OpenAI：LLM_PROVIDER=openai 时使用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA：LLM_PROVIDER=nvidia 时使用。
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 通用 OpenAI 兼容接口：LLM_PROVIDER=custom 时使用。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 本地模型：LLM_PROVIDER=local 时使用。
LOCAL_BASE_URL=
LOCAL_API_KEY=local

# ==================== 飞书配置（可选） ====================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
